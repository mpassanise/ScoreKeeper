{
  "expo": {
    "name": "Scorekeeper",
    "slug": "scorekeeper",
    "version": "1.1.0",
    "scheme": "scorekeeper",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mpassanise.scorekeeper",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mpassanise.scorekeeper"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "eas": {
        "projectId": "5ecd881c-9834-459c-b443-99cda9749cf6"
      }
    },
    "icon": "./assets/icon.png",
    "owner": "mpassanise-dev"
  }
}
